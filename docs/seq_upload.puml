@startuml seq_upload
' ============================================================
' BCE : Boundary → Control → Entity
' Boundary  🖥️  Interface chatbot
' Control   ⚙️  ChatbotController / RAGService
' Entity    🗄️  Base Vectorielle (ChromaDB) / Base de Données
' ============================================================

skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam sequenceParticipantBorderColor #2C3E50
skinparam sequenceParticipantBackgroundColor #ECF0F1
skinparam noteBorderColor #F39C12
skinparam noteBackgroundColor #FDEBD0

title Processus d'upload et d'indexation d'un document

actor Utilisateur
participant B  as "🖥️ Interface chatbot"       <<Boundary>>
participant C  as "⚙️ ChatbotController"        <<Control>>
participant RAG as "⚙️ RAGService"              <<Control>>
participant EV as "🗄️ Base Vectorielle"         <<Entity>>
participant E  as "🗄️ Base de Données"          <<Entity>>

Utilisateur -> B  : Sélectionner un fichier PDF
B  -> B  : Valider format et taille
B  -> C  : uploaderDocument(fichier)
C  -> E  : enregistrerDocument(nom, chemin, utilisateur)
E  --> C : documentId

C  -> RAG : indexerDocument(chemin, collection)
RAG -> RAG : Extraire texte (PyMuPDF)\n→ découper en chunks

loop Pour chaque chunk
    RAG -> RAG : Générer embedding (384 dim.)
    RAG -> EV  : stockerChunk(chunk, embedding)
end

RAG --> C : Indexation terminée (nombre de pages)
C  -> E  : mettreAJourDocument(documentId, pages)
C  --> B : Document indexé
B  --> Utilisateur : "Document indexé ✅"

@enduml
