# ============================================
# Smart Focus & Life Assistant - Backend Config
# Copy this file to .env and fill in real values.
# Generate SECRET_KEY with: openssl rand -hex 32
# ============================================

# PostgreSQL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/smartFocus_db

# JWT
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=False

# LLM provider: "gemini" or "groq"
AI_PROVIDER=groq
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash
LLM_MAX_RPM=25

# Google Gemini / OAuth
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE
GOOGLE_OAUTH_CLIENT_IDS=YOUR_GOOGLE_OAUTH_CLIENT_ID_HERE

# Storage paths (relative to backend/)
CHROMA_DB_PATH=chroma_db
UPLOADS_DIR=uploads
